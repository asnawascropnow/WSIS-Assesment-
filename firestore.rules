rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /assessments/{assessmentId} {
      allow create: if request.resource.data.keys().hasAll([
          'schemaVersion',
          'assessmentType',
          'status',
          'institutionName',
          'questionnaireVersion',
          'answers',
          'metadata',
          'attachments'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion',
          'assessmentType',
          'status',
          'institutionName',
          'questionnaireVersion',
          'answers',
          'metadata',
          'attachments'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.assessmentType in ['university', 'industry', 'organization']
        && request.resource.data.status == 'submitted'
        && request.resource.data.institutionName is string
        && request.resource.data.institutionName.size() <= 250
        && request.resource.data.questionnaireVersion in ['university-1.0', 'industrial-1.0', 'organization-1.0']
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().size() <= 20
        && request.resource.data.metadata is map
        && request.resource.data.metadata.keys().hasAll(['createdAt', 'updatedAt', 'submittedAt', 'createdBy'])
        && request.resource.data.metadata.keys().hasOnly(['createdAt', 'updatedAt', 'submittedAt', 'createdBy'])
        && request.resource.data.metadata.createdAt == request.time
        && request.resource.data.metadata.updatedAt == request.time
        && request.resource.data.metadata.submittedAt == request.time
        && request.resource.data.metadata.createdBy == null
        && request.resource.data.attachments is list
        && request.resource.data.attachments.size() <= 100;

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
